# ==========================================
# PostgreSQL configuration (Docker Compose)
# ==========================================

POSTGRES_USER=scrapeflow
POSTGRES_PASSWORD=replace_with_your_password
POSTGRES_DB=scrapeflow


# ==========================================
# Application database connection
# ==========================================

# Used when running Python directly outside Docker.
# Replace the password with your local PostgreSQL password.
DATABASE_URL=postgresql+psycopg://scrapeflow:replace_with_your_password@127.0.0.1:5433/scrapeflow


# ==========================================
# Celery and Redis
# ==========================================

# These URLs are for local Python processes.
# Docker Compose supplies container-specific URLs.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1


# ==========================================
# Scraping configuration
# ==========================================

# Comma-separated list of approved websites.
ALLOWED_HOSTS=books.toscrape.com,quotes.toscrape.com


# ==========================================
# Logging
# ==========================================

LOG_LEVEL=INFO


# ==========================================
# Testing (optional)
# ==========================================

# Dedicated test database. Never point this at the development database.
TEST_DATABASE_URL=postgresql+psycopg://scrapeflow:replace_with_your_password@127.0.0.1:5433/scrapeflow_test
