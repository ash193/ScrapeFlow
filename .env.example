
# ScrapeFlow — Example Environment Configuration
# Copy this file to .env and adjust values for your environment.
# Do not put real passwords or secrets in this example file.

# PostgreSQL database connection
# Uses the local PostgreSQL user and Unix socket on macOS.
DATABASE_URL=postgresql+psycopg:///scraperflow

# Planned Celery/Redis configuration
# Currently configured directly in app/celery_app.py.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
